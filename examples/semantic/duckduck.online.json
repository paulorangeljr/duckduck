{
  "services": {
    "samples": {
      "connector": "python",
      "module": "sample_sources.py",
      "table_prefix": ""
    }
  },
  "ai_providers": {
    "jev": {
      "provider": "jev",
      "model": "typesafe-ai/jev"
    },
    "jev_openrouter": {
      "provider": "openrouter",
      "api": "decisions",
      "model": "typesafe/jev-1.13"
    },
    "claude_strong": {
      "provider": "anthropic",
      "model": "claude-opus-5"
    },
    "claude_fast": {
      "provider": "anthropic",
      "model": "claude-haiku-4-5"
    }
  },
  "semantic": {
    "catalog_path": "catalog.yaml",
    "decision_engine": {
      "ai_provider": "jev"
    },
    "default_llm": "claude_strong",
    "extractor": {
      "type": "llm",
      "llm": "claude_fast",
      "system_prompt_file": "prompts/extraction.md"
    },
    "catalog_generation": {
      "output_path": "generated_catalog.yaml",
      "sample_rows": 5,
      "source_prompt_file": "prompts/catalog_source.md",
      "link_prompt_file": "prompts/catalog_link.md"
    }
  }
}
