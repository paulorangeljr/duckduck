{
  "domain": "inventory",
  "domain_description": "Raw: the inventory sources as they came, appended every run (_loaded_at / _load_date / _run_id are added by the runner). Runs as often as the sources change.",
  "layer": "raw",
  "sip": {
    "rate": 0.02,
    "max_rows": 50
  },
  "tables": {
    "assets": {
      "description": "The assets API.",
      "primary_key": "hostname",
      "sql": "SELECT * FROM assets",
      "load": "full",
      "target": {
        "mode": "append",
        "partition_by": "_load_date"
      },
      "sip": {
        "watch": ["web-0001"],
        "columns": ["ip", "os", "risk", "last_seen"]
      }
    },
    "owners": {
      "description": "Who owns each IP — the owners file.",
      "primary_key": "ip",
      "sql": "SELECT * FROM owners",
      "load": "full",
      "target": {
        "mode": "append",
        "partition_by": "_load_date"
      }
    }
  }
}
