{
  "domain": "inventory",
  "domain_description": "Silver: one row per key, merged from what raw loaded since the last silver run. Runs on its own schedule.",
  "layer": "silver",
  "sip": {
    "rate": 0.02,
    "max_rows": 50
  },
  "tables": {
    "assets": {
      "primary_key": "hostname",
      "sql": "SELECT * FROM raw.inventory.assets",
      "load": "incremental",
      "target": {
        "mode": "merge"
      },
      "sip": {
        "watch": ["web-0001"],
        "columns": ["ip", "os", "risk", "last_seen"]
      }
    },
    "owners": {
      "primary_key": "ip",
      "sql": "SELECT * FROM raw.inventory.owners",
      "load": "incremental",
      "target": {
        "mode": "merge"
      }
    }
  }
}
