{
  "domain": "inventory",
  "description": "Silver: one row per key, merged from what raw loaded since the last silver run. Runs on its own schedule.",
  "layer": "silver",
  "load": "incremental",
  "target": {
    "mode": "merge"
  },
  "sip": {
    "rate": 0.02,
    "max_rows": 50
  },
  "jobs": {
    "assets": {
      "primary_key": "hostname",
      "sql": "SELECT * FROM raw_assets",
      "sip": {
        "watch": ["web-0001"],
        "columns": ["ip", "os", "risk", "last_seen"]
      }
    },
    "owners": {
      "primary_key": "ip",
      "sql": "SELECT * FROM raw_owners"
    }
  }
}
