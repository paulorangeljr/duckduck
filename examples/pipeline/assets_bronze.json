{
  "pipeline": "assets_bronze",
  "description": "Raw: the assets API as it came, appended every run (_loaded_at / _load_date / _run_id are added by the runner). Runs as often as the source changes.",
  "layer": "raw",
  "primary_key": "hostname",
  "load": "full",
  "sql": "SELECT * FROM assets",
  "target": {
    "database": "inventory",
    "table_name": "assets",
    "mode": "append",
    "partition_by": "_load_date"
  },
  "sip": {
    "rate": 0.02,
    "max_rows": 50,
    "watch": [
      "web-0001"
    ],
    "columns": [
      "ip",
      "os",
      "risk",
      "last_seen",
      "_loaded_at"
    ]
  }
}
