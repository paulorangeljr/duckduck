{
  "pipeline": "gold_risk",
  "description": "Risky hosts per department and OS, from the silver assets and the owners file.",
  "notebook": "gold_risk.ipynb",
  "engine": "duckdb",
  "primary_key": "hostname",
  "parameters": {"min_risk": 50},
  "target": {"path": "lake/gold_risk", "mode": "overwrite"},
  "sip": {
    "rate": 0.02,
    "max_rows": 50,
    "watch": ["web-0001"],
    "columns": ["risk", "department", "hosts", "avg_risk"],
    "store": "lake/_sip"
  }
}
