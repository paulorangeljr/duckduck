{
  "pipeline": "assets_silver",
  "description": "Silver: one row per host, merged from what raw loaded since the last silver run. Runs on its own schedule.",
  "layer": "silver",
  "primary_key": "hostname",
  "sql": "SELECT * FROM raw_assets",
  "load": "incremental",
  "target": {
    "database": "inventory",
    "table_name": "assets",
    "mode": "merge"
  },
  "sip": {
    "rate": 0.02,
    "max_rows": 50,
    "watch": [
      "web-0001"
    ],
    "columns": [
      "ip",
      "os",
      "risk",
      "last_seen"
    ]
  }
}
