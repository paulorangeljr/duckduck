{
  "services": {
    "sharepoint": {
      "connector": "sharepoint",
      "hostname": "company.sharepoint.com",
      "site_path": "/teams/myteam",
      "authentication": {
        "type": "aws",
        "region_name": "us-east-1",
        "profile_name": "prod-account",
        "secret_id": "prod/sharepoint/duckduck"
      }
    },
    "insightvm": {
      "connector": "insightvm",
      "host": "console.local",
      "authentication": {
        "type": "azure",
        "vault_url": "https://my-vault.vault.azure.net/",
        "tenant_id": "00000000-0000-0000-0000-000000000000",
        "secret_id": "prod-insightvm",
        "password": "$secret.svc_password"
      }
    },
    "insightvm_dev": {
      "connector": "insightvm",
      "host": "dev.local",
      "authentication": {
        "type": "local",
        "username": "a",
        "password": "b"
      }
    },
    "sqlserver": {
      "connector": "database",
      "authentication": {
        "type": "local",
        "connection_string": "mssql+pyodbc://user:pass@host:1433/db?driver=ODBC+Driver+17+for+SQL+Server"
      }
    },
    "mysql": {
      "connector": "database",
      "authentication": {
        "type": "aws",
        "region_name": "us-east-1",
        "secret_id": "prod/mysql"
      }
    },
    "sqlserver_from_rds_secret": {
      "connector": "database",
      "authentication": {
        "type": "aws",
        "region_name": "us-east-1",
        "secret_id": "prod/sqlserver-rds",
        "drivername": "mssql+pyodbc",
        "database": "$secret.dbname",
        "query": {
          "driver": "ODBC Driver 17 for SQL Server"
        }
      }
    },
    "servicenow": {
      "connector": "servicenow",
      "authentication": {
        "type": "aws",
        "region_name": "us-east-1",
        "secret_id": "prod/servicenow"
      }
    },
    "servicenow_oauth2": {
      "connector": "servicenow",
      "authentication": {
        "type": "local",
        "token_url": "https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/oauth2/token",
        "client_id": "...",
        "client_secret": "...",
        "resource": "api://your-servicenow-app-id",
        "api_base": "https://internal-gateway.company.com/v1/now"
      }
    },
    "nvd": {
      "connector": "nvd",
      "authentication": {"type": "aws", "secret_id": "prod/nvd", "api_key": "$secret.api_key"}
    },
    "world": {
      "connector": "restcountries",
      "authentication": {"type": "aws", "secret_id": "prod/restcountries", "api_key": "$secret.api_key"}
    },
    "axonius": {
      "connector": "axonius",
      "authentication": {
        "type": "local",
        "instance": "axonius.company.com",
        "api_key": "...",
        "api_secret": "..."
      }
    },
    "s3_data": {
      "connector": "glue",
      "authentication": {
        "type": "local",
        "region_name": "us-east-1",
        "profile_name": "prod-account"
      }
    },
    "adls": {
      "connector": "blob_storage",
      "authentication": {
        "type": "local",
        "account_name": "mystorageacct"
      }
    },
    "adx_app_registration": {
      "connector": "adx",
      "cluster": "mycluster.westeurope",
      "database": "SecurityLogs",
      "authentication": {
        "type": "azure",
        "vault_url": "https://my-vault.vault.azure.net/",
        "secret_id": "adx-app"
      }
    },
    "adx_managed_identity": {
      "connector": "adx",
      "cluster": "https://mycluster.westeurope.kusto.windows.net",
      "database": "SecurityLogs",
      "notruncation": false,
      "authentication": {
        "type": "local",
        "tenant_id": "00000000-0000-0000-0000-000000000000"
      }
    }
  },
  "ai_providers": {
    "jev": {
      "provider": "jev",
      "model": "typesafe-ai/jev",
      "timeout": 15,
      "authentication": {
        "type": "aws",
        "region_name": "us-east-1",
        "secret_id": "prod/jev",
        "api_key": "$secret.jev_api_key"
      }
    },
    "jev_openrouter": {
      "provider": "openrouter",
      "api": "decisions",
      "model": "typesafe/jev-1.13",
      "authentication": {
        "type": "aws",
        "region_name": "us-east-1",
        "secret_id": "prod/openrouter",
        "api_key": "$secret.api_key"
      }
    },
    "claude": {
      "provider": "anthropic",
      "model": "claude-opus-5",
      "effort": "high",
      "authentication": {
        "type": "azure",
        "vault_url": "https://my-vault.vault.azure.net/",
        "secret_id": "anthropic-api",
        "api_key": "$secret.key"
      }
    },
    "azure_gpt": {
      "provider": "azure_openai",
      "endpoint": "https://my-resource.openai.azure.com",
      "deployment": "gpt-mini",
      "api_version": "2024-10-21",
      "authentication": {
        "type": "azure",
        "vault_url": "https://my-vault.vault.azure.net/",
        "secret_id": "azure-openai",
        "api_key": "$secret.key"
      }
    }
  },
  "semantic": {
    "catalog_path": "semantic_catalog.yaml",
    "default_limit": 1000,
    "feedback": {"enabled": true, "path": "feedback.duckdb", "memory": true, "max_cases": 3, "min_similarity": 0.6, "min_support": 2},
    "answer_shapes": {
      "lookup": {"wording": ["o que rola com", "ficha do"]},
      "count_by": {"maybe_wording": ["segundo"]}
    },
    "allowed_sources": null,
    "thresholds": {
      "source": 0.8,
      "field": 0.85,
      "relationship": 0.9,
      "critical": 0.98
    },
    "decision_engine": {
      "ai_provider": "jev",
      "retries": 2
    },
    "default_llm": "claude",
    "extractor": {
      "type": "llm",
      "llm": "azure_gpt",
      "on_error": "fallback"
    },
    "catalog_generation": {
      "output_path": "generated_catalog.yaml",
      "sample_rows": 5,
      "api_docs": {
        "insightvm": "docs/insightvm-openapi.json",
        "servicenow:incidents": {"location": "docs/servicenow-incident.md"},
        "axonius": {"content": {"tables": {"devices": {
          "description": "Devices correlated from every adapter.",
          "fields": {"os_type": {"description": "Operating system family", "values": {"Windows": ["win"], "Linux": []}}}
        }}}}
      },
      "tables": [
        {
          "name": "proxy_logs",
          "table": "s3_data_table",
          "args": {
            "database": "security",
            "table_name": "proxy_logs"
          },
          "notes": "Zscaler proxy logs, one row per HTTP request"
        },
        {
          "name": "incidents",
          "table": "servicenow_incidents"
        }
      ]
    }
  }
}
