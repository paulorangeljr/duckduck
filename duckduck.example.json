{
  "services": {
    "sharepoint": {
      "connector": "sharepoint",
      "hostname": "company.sharepoint.com",
      "site_path": "/teams/myteam",
      "authentication": {
        "type": "aws",
        "region_name": "us-east-1",
        "profile_name": "prod-account",
        "secret_id": "prod/sharepoint/duckduck"
      }
    },
    "insightvm": {
      "connector": "insightvm",
      "host": "console.local",
      "authentication": {
        "type": "azure",
        "vault_url": "https://my-vault.vault.azure.net/",
        "tenant_id": "00000000-0000-0000-0000-000000000000",
        "secret_id": "prod-insightvm",
        "password": "$secret.svc_password"
      }
    },
    "insightvm_dev": {
      "connector": "insightvm",
      "host": "dev.local",
      "authentication": {
        "type": "local",
        "username": "a",
        "password": "b"
      }
    },
    "sqlserver": {
      "connector": "database",
      "authentication": {
        "type": "local",
        "connection_string": "mssql+pyodbc://user:pass@host:1433/db?driver=ODBC+Driver+17+for+SQL+Server"
      }
    },
    "mysql": {
      "connector": "database",
      "authentication": {
        "type": "aws",
        "region_name": "us-east-1",
        "secret_id": "prod/mysql"
      }
    },
    "sqlserver_from_rds_secret": {
      "connector": "database",
      "authentication": {
        "type": "aws",
        "region_name": "us-east-1",
        "secret_id": "prod/sqlserver-rds",
        "drivername": "mssql+pyodbc",
        "database": "$secret.dbname",
        "query": { "driver": "ODBC Driver 17 for SQL Server" }
      }
    }
  }
}
