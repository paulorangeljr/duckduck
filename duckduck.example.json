{
  "services": {
    "sharepoint": {
      "connector": "sharepoint",
      "hostname": "company.sharepoint.com",
      "site_path": "/teams/myteam",
      "authentication": {
        "type": "aws",
        "region_name": "us-east-1",
        "secret_id": "prod/sharepoint/duckduck"
      }
    },
    "insightvm": {
      "connector": "insightvm",
      "host": "console.local",
      "authentication": {
        "type": "azure",
        "vault_url": "https://my-vault.vault.azure.net/",
        "secret_id": "prod-insightvm",
        "password": "$secret.svc_password"
      }
    },
    "insightvm_dev": {
      "connector": "insightvm",
      "host": "dev.local",
      "authentication": {
        "type": "local",
        "username": "a",
        "password": "b"
      }
    }
  }
}
